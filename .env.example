# Vastavik Learning Platform - Environment Configuration

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Static API Keys (matching Android client AuthInterceptor.kt)
API_KEY_ID=vastavik_prod_v1
API_KEY_SECRET=super_secret_hmac_production_key_change_me_32char

# JWT Authentication
JWT_SECRET_KEY=super_jwt_secret_key_change_this_in_production_min_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Credentials
ADMIN_EMAIL=admin@vastaviklearning.com
ADMIN_PASSWORD=change_this_admin_password_123!

# External Online Judge (Judge0)
# Default self-hosted VPS endpoint, with 10s fail-fast timeout
JUDGE0_URL=http://139.84.172.230:2358
JUDGE0_TIMEOUT_SECONDS=10.0
JUDGE0_AUTH_TOKEN=

# AI Provider API Keys
# Fallback hierarchy: Mistral Small -> Gemini 3.7 Flash -> Gemini 3.6 Flash
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Firebase / Firestore Credentials
# Path to service account JSON (leave empty to use resilient in-memory development repository)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=vastavik-learning

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=

# Payment Gateway (PhonePe / Razorpay / Cashfree)
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Rate Limits (Requests per minute)
RATE_LIMIT_AUTH=5
RATE_LIMIT_AI=10
RATE_LIMIT_CODE=8
RATE_LIMIT_GENERAL=120
RATE_LIMIT_WEBRTC=600

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
